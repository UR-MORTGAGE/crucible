# Copy to .env and fill in. Defaults keep everything in offline mock mode.

# mock = deterministic, no network (runs the real DTI/LTV math, stubs the LLMs)
# live = call the local vLLM model + Fireworks
CRUCIBLE_MODE=mock

# --- Local lane: open model served on the MI300X via vLLM (ROCm) ---
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- Cloud lane: Fireworks AI API (frontier reasoning + adjudication) ---
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct

# Router: escalate a local step to the cloud when self-reported confidence is below this
ROUTER_ESCALATE_THRESHOLD=0.7
